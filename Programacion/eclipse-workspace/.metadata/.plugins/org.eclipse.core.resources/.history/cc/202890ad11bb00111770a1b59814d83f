package logica;

public class OPdecisiones1 {

	public static void main(String[] args) {
		int num = -1000000000;
		String trocito;
		
		if(num<-1000000) {
			trocito="muy negativo";
		}else if(num<0) {
			trocito="negativo";
		} else if(num==0) {
			trocito="es cero";
		}else if(num>0) {
			trocito="positivo";
		}else {
			trocito="muy positivo";
		}
		System.out.printf("el numero %d es %d%n",num,trocito);
			

	}

}

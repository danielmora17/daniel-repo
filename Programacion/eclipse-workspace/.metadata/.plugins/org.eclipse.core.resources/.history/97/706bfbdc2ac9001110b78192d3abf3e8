package arrays;

public class arrayprueba3 {

	public static void main(String[] args) {
		int [] numeros1= {1, 2, 3, 4};
		int [] numeros2= {0, 0, 0, 0};
		for(int i=0;i<numeros1.length;i++) {
			numeros1[i]*=2;
			numeros1=numeros2;
			System.out.println(numeros2[i]+" ");
		}
		for(int n: numeros2) {
			System.out.println(n+ " ");
		}
		System.out.println();
		}
	}


